# LAN IP:port of the running apps/api server. Required — on a physical phone
# in Expo Go, "localhost" resolves to the phone itself, not this machine, so
# there is no safe fallback default. Re-check with `ipconfig` whenever the
# dev machine's network changes. On the Android emulator, http://10.0.2.2:3000
# (the emulator's alias for the host's localhost) also works if the LAN IP
# ever stops being reachable from it.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
