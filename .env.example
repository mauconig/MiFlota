# Credenciales del primer usuario. Se aplican una sola vez, al arrancar con la
# tabla de usuarios vacía; después la contraseña vive hasheada (scrypt) en la
# base y cambiar estos valores no la modifica.
#
# Copiar a .env y completar. El .env no se versiona.
MIFLOTA_ADMIN_USER=admin
MIFLOTA_ADMIN_PASSWORD=
MIFLOTA_ADMIN_NOMBRE=MiFlota

# Zona horaria de negocio para fechas y resumen diario de alertas.
MIFLOTA_TIME_ZONE=America/Asuncion

# Permite desactivar envíos push en la VPS durante una prueba.
MIFLOTA_PUSH_ENABLED=true

# Asistente de admin-mobile. La clave vive únicamente en el servidor: nunca
# usar un nombre EXPO_PUBLIC_ porque Expo lo incluiría dentro de la app.
# OpenRouter (el backend nunca expone esta clave a las apps)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloudinary para comprobantes. Estas claves se usan únicamente en la API;
# nunca las pongas en variables EXPO_PUBLIC_ ni en el frontend.
# La carpeta existente en Cloudinary es `miflota`.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=miflota
